{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "request": "attach",
            "name": "Attach by Process ID",
            "processId": "${command:PickJavaProcess}"
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },

        // ---- МОЯ НОВА КОНФІГУРАЦІЯ ----
        {
            "name": "MediaVault Backend",
            "type": "debugpy",
            "request": "launch",
            "module": "mv_back.app",
            "cwd": "D:/Else/Code/MediaVault",
            "python": "D:/Else/Code/MediaVault/mv_back/env/Scripts/python.exe",
            "console": "integratedTerminal"
        },
        
        {
            "name": "Transfer_DB Module",
            "type": "debugpy",
            "request": "launch",
            "module": "mv_back.db.transfer_db",
            "cwd": "D:/Else/Code/MediaVault",
            "python": "D:/Else/Code/MediaVault/mv_back/env/Scripts/python.exe",
            "console": "integratedTerminal"
        }

        // --------------------------------
    ]
}
