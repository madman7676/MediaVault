{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "request": "attach",
            "name": "Attach by Process ID",
            "processId": "${command:PickJavaProcess}"
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },

        // ---- МОЯ НОВА КОНФІГУРАЦІЯ ----
        {
            "name": "MediaVault (env)",
            "type": "debugpy",
            "request": "launch",
            "program": "app.py",
            "cwd": "D:/Else/Code/MediaVault/mv_back",
            "python": "D:/Else/Code/MediaVault/mv_back/env/Scripts/python.exe",
            "console": "integratedTerminal"
        }
        // --------------------------------
    ]
}
